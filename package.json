{
  "name": "r-version-switcher",
  "displayName": "R Version Switcher",
  "description": "⚠️ Purely vibe-coded (AI-written), use at your own risk. Switch, install and remove R versions managed by rig (R Installation Manager)",
  "version": "1.1.0",
  "publisher": "OndrejMottl",
  "author": {
    "name": "Your Name"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.64.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "R",
    "rig",
    "version",
    "switcher",
    "R language",
    "R version manager",
    "multi-platform"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "r.switchVersion",
        "title": "Switch Version",
        "category": "R"
      },
      {
        "command": "r.showCurrentVersion",
        "title": "Show Current Version",
        "category": "R"
      },
      {
        "command": "r.addVersion",
        "title": "Add Version",
        "category": "R"
      },
      {
        "command": "r.removeVersion",
        "title": "Remove Version",
        "category": "R"
      },
      {
        "command": "r.setDefaultVersion",
        "title": "Set System Default Version",
        "category": "R"
      },
      {
        "command": "r.installRtools",
        "title": "Install Rtools",
        "category": "R"
      },
      {
        "command": "r.useRenvVersion",
        "title": "Use R Version from renv.lock",
        "category": "R"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "r.installRtools",
          "when": "isWindows"
        }
      ]
    },
    "configuration": {
      "title": "R Version Switcher",
      "properties": {
        "rVersionSwitcher.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the workspace R version in the status bar in R projects (with renv.lock, an R file open, or a workspace R path)."
        },
        "rVersionSwitcher.checkRenvLock": {
          "type": "boolean",
          "default": true,
          "description": "When a workspace opens, warn if its R version differs from the one in renv.lock."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "rig",
        "required": [
          "args"
        ],
        "properties": {
          "args": {
            "type": "array",
            "description": "Arguments passed to rig."
          }
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/r-version-switcher"
  },
  "bugs": {
    "url": "https://github.com/yourusername/r-version-switcher/issues"
  },
  "homepage": "https://github.com/yourusername/r-version-switcher#readme",
  "extensionDependencies": [
    "REditorSupport.r"
  ],
  "scripts": {
    "test": "mocha --ui tdd test/unit",
    "test:integration": "node ./test/runTest.js",
    "lint": "echo 'No linter configured yet'",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.x",
    "mocha": "^10.0.0",
    "glob": "^8.0.0",
    "@vscode/test-electron": "^2.1.0"
  }
}
